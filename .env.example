# Set these in your Vercel project's environment variables before deployment.
# Find both public settings in your Supabase project's Connect dialog.
# /api/config returns these values to the browser. Never use a secret or service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Only for logging from your phone through Claude (/api/mcp). Never sent to the browser.
# The email and password of the user you created in Supabase Authentication.
WIRE_EMAIL=
WIRE_PASSWORD=
# A long random string you make, for example: openssl rand -hex 32
WIRE_TOKEN=
# Optional: a second token that opens only /api/photo, for the iOS Shortcut. Unset, the Shortcut uses WIRE_TOKEN.
WIRE_PHOTO_TOKEN=
